{
  "expo": {
    "name": "Spot",
    "slug": "spotpeche",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gasmianouar.spotpeche",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C3438",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gasmianouar.spotpeche"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spot utilise votre position pour centrer la carte sur les spots autour de vous."
        }
      ],
      "expo-sqlite",
      "./plugins/withLowMemoryGradle"
    ],
    "scheme": "spotpeche",
    "experiments": {
      "typedRoutes": true
    }
  }
}