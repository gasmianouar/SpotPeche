# Copiez ce fichier en .env.local (ignoré par Git) et mettez l'adresse de VOTRE serveur d'agent IA.
# Sans adresse, l'app utilise son algorithme local.
EXPO_PUBLIC_SPOT_AI_URL=

# Serveur Supabase (voir docs/BACKEND.md). Laissez vide pour le mode local (tout reste sur le téléphone).
# Uniquement l'adresse du projet et la clé PUBLIABLE (sb_publishable_...) : JAMAIS la clé secrète / service_role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
